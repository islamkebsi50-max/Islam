rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // السماح للجميع بقراءة المنتجات (للعملاء)
    match /products/{productId} {
      allow read;
      // فقط المسؤول يمكنه الكتابة والتعديل والحذف
      allow write: if request.auth != null && 
                      request.auth.token.email == 'isslamkebsi34@gmail.com';
    }

    // السماح بإنشاء طلب جديد (لا يحتاج authentication)
    // لكن لا يمكن قراءة أو تعديل طلبات الآخرين
    match /orders/{orderId} {
      allow create;
      // فقط المسؤول يمكنه قراءة وتعديل جميع الطلبات
      allow read, update: if request.auth != null && 
                             request.auth.token.email == 'isslamkebsi34@gmail.com';
      // منع الحذف
      allow delete: if false;
    }

    // منع الوصول إلى أي مجموعات أخرى
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
